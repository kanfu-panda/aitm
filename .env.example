# aitm 可识别的环境变量（结构示例，不含真值）。
#
# 用法：复制为 `~/.aitm/.env`，按需填写。
# 查找顺序：进程环境变量 → 这个 .env 文件 → 设置面板里保存的配置；留空的项视为未配置。
# 各 AI Provider 也可以直接在「设置 → AI Provider」里填写，二者选其一即可。
#
# 注意：真实的 key 只写在本机的 .env 里，不要提交进仓库。

# ---- AI Provider：API key ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
ZHIPU_API_KEY=
MOONSHOT_API_KEY=

# ---- AI Provider：自定义接口地址（可选，不填用内置默认值）----
# 例：Qwen 海外站填 https://dashscope-intl.aliyuncs.com/compatible-mode/v1
ANTHROPIC_BASE_URL=
OPENAI_BASE_URL=
DEEPSEEK_BASE_URL=
QWEN_BASE_URL=
ZHIPU_BASE_URL=
MOONSHOT_BASE_URL=

